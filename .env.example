# AD BARBERSHOP - Environment Variables Template
# Isi variabel berikut sesuai project Supabase dan Vercel Anda.

# PostgreSQL Connection String (Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection string)
# Format Transaction Pooler (direkomendasikan untuk Vercel Serverless):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL untuk migrasi Prisma (Port 5432 session mode):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Keys (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret Key untuk JWT Cookie Session Admin
JWT_SECRET="ad-barbershop-super-secure-jwt-key-32-chars-minimum"

# App URL (Gunakan http://localhost:3000 untuk lokal, atau URL Vercel saat production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
